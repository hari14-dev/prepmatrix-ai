PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=a_random_string_at_least_8_characters
JWT_EXPIRES_IN=7d

# AI features (resume audit, hints, mock interview) — optional.
# Without this, AI features fall back to static content instead of failing.
GROQ_API_KEY=your_groq_api_key

# DSA code execution — required for the DSA practice IDE to run code.
ONECOMPILER_RAPIDAPI_KEY=your_rapidapi_key
ONECOMPILER_API_URL=https://onecompiler-apis.p.rapidapi.com
ONECOMPILER_RAPIDAPI_HOST=onecompiler-apis.p.rapidapi.com

# Google Sign-In — optional. Without this set, the Google button simply
# doesn't render and email/password auth still works normally.
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
